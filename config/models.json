{
  "providers": {
    "deepseek": {
      "name": "DeepSeek",
      "baseUrl": "https://api.deepseek.com",
      "apiKey": "$DEEPSEEK_API_KEY",
      "api": "openai-completions",
      "authHeader": true,
      "models": [
        {
          "id": "deepseek-chat",
          "name": "DeepSeek V3 (chat)",
          "reasoning": false,
          "input": ["text"],
          "cost": { "input": 0.00000027, "output": 0.0000011, "cacheRead": 0.00000007, "cacheWrite": 0 },
          "contextWindow": 65536,
          "maxTokens": 8192,
          "compat": { "supportsStrictMode": false }
        },
        {
          "id": "deepseek-reasoner",
          "name": "DeepSeek R1 (reasoner)",
          "reasoning": true,
          "input": ["text"],
          "cost": { "input": 0.00000055, "output": 0.00000219, "cacheRead": 0.00000014, "cacheWrite": 0 },
          "contextWindow": 65536,
          "maxTokens": 8192,
          "compat": { "thinkingFormat": "deepseek", "supportsStrictMode": false }
        }
      ]
    }
  }
}
