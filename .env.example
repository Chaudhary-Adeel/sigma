# ─── Sigma configuration ──────────────────────────────────────────────────────
# Copy to .env and fill in. Everything is bring-your-own-key.

# ─── LLM (default model is DeepSeek) ──────────────────────────────────────────
# Get a key at https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# Optional fallback providers (used only if you switch models)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default model id (provider/model). Override per-agent in the DB.
SIGMA_MODEL=deepseek/deepseek-chat

# ─── Sandbox (Docker) ─────────────────────────────────────────────────────────
# Base image used for task sandboxes. Must have a shell; node/git recommended.
SIGMA_SANDBOX_IMAGE=node:22-bookworm-slim
# Disable container network access for tasks (true/false). Connectors still work
# from the host. Default false.
SIGMA_SANDBOX_NO_NETWORK=false
# Per-container memory / cpu limits.
SIGMA_SANDBOX_MEMORY=2g
SIGMA_SANDBOX_CPUS=2

# ─── GitHub connector ─────────────────────────────────────────────────────────
# A classic or fine-grained PAT with repo scope. https://github.com/settings/tokens
GITHUB_TOKEN=

# ─── Gmail connector ──────────────────────────────────────────────────────────
# Create an OAuth 2.0 Client (type: Desktop app) in Google Cloud Console:
#   https://console.cloud.google.com/apis/credentials
# Enable the Gmail API for the project. Then run: sigma connector login gmail
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Redirect used for the installed-app flow (default is fine for desktop apps).
GOOGLE_OAUTH_REDIRECT=http://localhost:53682/oauth2callback

# ─── Paths ────────────────────────────────────────────────────────────────────
# Where Sigma keeps its db, auth, workspaces. Default ~/.sigma
# SIGMA_HOME=
